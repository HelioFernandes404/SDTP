# Configuração do laboratório local (VMs KVM/libvirt).
# Lido por bootstrap.sh. Pode ser sobrescrito por variáveis de ambiente.

LIBVIRT_URI="${LIBVIRT_URI:-qemu:///system}"
POOL="${POOL:-default}"

# Rede isolada do lab (NAT), separada da rede "default" do libvirt.
NET_NAME="${NET_NAME:-desafio-net}"

# Imagem base: Ubuntu 24.04 LTS (cloud image oficial).
IMG_URL="${IMG_URL:-https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img}"
IMG_SUMS_URL="${IMG_SUMS_URL:-https://cloud-images.ubuntu.com/noble/current/SHA256SUMS}"
BASE_VOL="desafio-noble-base.qcow2"

# Usuário temporário criado pelo cloud-init só para o Ansible conectar.
# Endurecimento (usuário de operação, SSH sem senha/root) é papel da Parte 4.
BOOT_USER="${BOOT_USER:-bootstrap}"

DISK_SIZE="${DISK_SIZE:-20G}"

# nome  vcpus  ram(MiB)  mac                ip
NODES="
desafio-cp1  2  2048  52:54:00:de:5a:11  192.168.150.11
desafio-w1   2  2048  52:54:00:de:5a:21  192.168.150.21
desafio-w2   2  2048  52:54:00:de:5a:22  192.168.150.22
"
